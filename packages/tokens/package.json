{
  "name": "@mds/tokens",
  "version": "0.0.0",
  "description": "Design tokens (CSS custom properties) for My Design System.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./fonts/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts/fonts.css"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
